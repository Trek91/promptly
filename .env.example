# Demo is the default. No account or credentials are needed.
DEMO_MODE=true
# To enable real AI, set DEMO_MODE=false and add your server-side key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173
AI_TIMEOUT_MS=30000
# Keep 0 locally. Configure the exact proxy hop count only behind a trusted proxy.
TRUST_PROXY_HOPS=0
